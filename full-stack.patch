+    /// Validates bytes supplied by raw/plugin packet APIs.
+    pub fn try_from_bytes(bytes: Bytes) -> Result<Self, PacketEncodeError> {
+        if bytes.is_empty() {
+            return Err(PacketEncodeError::Message(
+                "Serialized packet must contain a packet ID".into(),
